{
  "hosting": [
    {
      "site": "digivoteindia",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2)",
          "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }]
        },
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "public,max-age=300" }]
        },
        {
          "source": "**/*.mp4",
          "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }]
        },
        {
          "source": "**/*.vtt",
          "headers": [
            { "key": "Content-Type", "value": "text/vtt; charset=utf-8" },
            { "key": "Cache-Control", "value": "public,max-age=604800" }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/app",
          "destination": "/get",
          "type": 301
        },
        {
          "source": "/app/**",
          "destination": "/get",
          "type": 301
        }
      ],
      "rewrites": [
        { "source": "/i/**", "destination": "/invite.html" },
        { "source": "**", "destination": "/index.html" }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "site": "digivote-prod",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://digivoteindia.web.app/:1",
          "type": 301
        }
      ]
    }
  ]
}
