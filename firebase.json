{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }]
      },
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=300" }]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
